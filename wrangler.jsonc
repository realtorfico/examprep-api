// Shared backend Worker for examprep.softician.com + examprep-admin.softician.com.
// No public hostname/route — both Pages projects reach this via a Service Binding
// (configured in *their* wrangler.jsonc), so nothing here needs a custom domain.
// Deploy via Cloudflare's git-connected Workers Builds (Wrangler doesn't run locally
// on this machine) — connected in the dashboard (Settings > Build): realtorfico/examprep-api,
// branch main, deploy command `npx wrangler deploy`, root directory `/`.
{
  "name": "examprep-api",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "d1_databases": [
    // Create the DB in the dashboard (Workers & Pages > D1 > Create), run schema.sql
    // via its Console tab, then paste the database_id here.
    { "binding": "DB", "database_name": "examprep", "database_id": "9dce57bc-02c9-41cb-8d56-3f5a3dd9347b" }
  ],
  "r2_buckets": [
    // Study-resource media (audio/video/pdf/image). No public custom domain on this bucket --
    // access is only via signed /media/:file URLs minted by /resources/sign-batch (see
    // src/lib/mediaSign.js), so this binding is the ONLY way to reach the file contents.
    { "binding": "MEDIA", "bucket_name": "examprep-media" }
  ]
  // Secrets/vars (set via dashboard: Settings > Variables & Secrets, not committed here):
  //   TURNSTILE_SECRET          — from the Turnstile widget (public site's /redeem form)
  //   CF_ACCESS_TEAM_DOMAIN     — e.g. yourteam.cloudflareaccess.com
  //   CF_ACCESS_AUD             — Access application's Audience (AUD) tag for examprep-admin
  //   CF_ACCESS_ALLOWED_EMAILS  — optional extra allowlist on top of the Access policy
  //   PAYPAL_CLIENT_ID          — from a REST API app at developer.paypal.com
  //   PAYPAL_CLIENT_SECRET      — from the same PayPal REST API app
  //   PAYPAL_ENV                — "sandbox" or "live" — picks the PayPal API host
  //   STRIPE_SECRET_KEY         — sk_live_... (or sk_test_...) from dashboard.stripe.com/apikeys
  //   RESEND_API_KEY            — from resend.com, for the optional backup-code email
  //   MEDIA_SIGNING_SECRET      — random string, HMACs the short-lived /media/:file URLs
}
